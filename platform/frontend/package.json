{
  "name": "starcloud-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "StarCloud phase-1 frontend: shared @sc/* packages, Wujie micro-frontend base, console sub-apps, marketing portal.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter console-base dev",
    "dev:base": "pnpm --filter console-base dev",
    "dev:ecs": "pnpm --filter console-ecs dev",
    "dev:site": "pnpm --filter site dev",
    "build:packages": "pnpm --filter './packages/*' build",
    "build": "pnpm build:packages && pnpm --filter './apps/*' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.0",
    "element-plus": "^2.7.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "vue": "^3.4.0",
    "vue-tsc": "^2.1.0",
    "wujie": "^1.0.0"
  },
  "dependencies": {
    "vue-i18n": "^9.14.5"
  },
  "pnpm": {
    "overrides": {
      "svgo": "4.1.0",
      "esbuild": "0.25.12"
    }
  }
}
