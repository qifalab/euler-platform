# Euler frontend — pnpm settings
#
# node-linker=hoisted: 用 npm 风格的扁平 node_modules，替代默认的 isolated(.pnpm) 布局。
# 原因：本机 Windows 环境下 pnpm 的硬链接/软链接导入会死锁（卡 added N 零进展），
#       isolated 布局下子项目 node_modules 还会批量建成空目录。hoisted 布局几乎不依赖
#       junction，是 pnpm 官方针对 Windows 链接问题的推荐退路，且对 GitHub 协作最友好
#       （node_modules/ 一条 .gitignore 规则即可干净排除，无 .pnpm 虚拟 store 噪音）。
node-linker=hoisted

# 完全扁平提升：把所有依赖平铺到根 node_modules（含传递依赖），最大化兼容各包
# 对「向上查找 node_modules」的假设，避免幽灵依赖导致的解析失败。
shamefully-hoist=true
