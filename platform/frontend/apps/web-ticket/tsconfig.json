{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"], "strict": true, "jsx": "preserve",
    "noEmit": true, "skipLibCheck": true, "esModuleInterop": true,
    "useDefineForClassFields": true, "baseUrl": ".", "paths": { "@/*": ["src/*"] }
  },
  "include": ["src", "*.vue"]
}
