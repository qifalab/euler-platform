# Copy to .env; it is local deployment configuration, never a Git commit.
# Generate ONCE with: openssl rand -base64 32
# Preserve this same key with every database backup. Losing it loses credentials.
EULER_ENCRYPTION_KEY=

# Single-origin local preview; no working identity is fabricated when unset.
EULER_BIND_ADDRESS=127.0.0.1
EULER_PORT=8080
EULER_PUBLIC_URL=http://localhost:8080
EULER_ALLOW_INSECURE_LOOPBACK=true

# E时代通行证 is the identity provider. EID is a membership application.
# For production use https://<your-cloud-origin> and set insecure loopback false.
EULER_IDENTITY_MODE=oidc
EULER_OIDC_ISSUER=
EULER_OIDC_CLIENT_ID=
EULER_OIDC_CLIENT_SECRET=
# Empty means EULER_PUBLIC_URL + /auth/callback; register this exact upstream URI.
EULER_OIDC_REDIRECT_URL=
EULER_OIDC_TOKEN_AUTH_METHOD=client_secret_basic

# Configure only when the upstream needs explicit OAuth2 userinfo compatibility.
EULER_OAUTH2_AUTHORIZATION_ENDPOINT=
EULER_OAUTH2_TOKEN_ENDPOINT=
EULER_OAUTH2_USERINFO_ENDPOINT=
EULER_OAUTH2_SUBJECT_CLAIM=sub
EULER_OAUTH2_USERINFO_ENVELOPE=

# Verified provider + subject of bootstrap platform operators. No default user.
# This grants permission to assign app review/admin rights, not automatic business access.
# Example: [{"provider":"https://accountapi.emoera.com/api","subject":"<your-sub>"}]
EULER_PLATFORM_ADMIN_IDENTITIES=[]

# CIDRs of reverse proxies allowed to supply the client IP for WeAuth risk rules.
# Set the actual internal nginx network, not an Internet-wide CIDR.
EULER_WEAUTH_TRUSTED_PROXIES=

# Euler-owned database infrastructure; never point at original product metadata databases.
EULER_DATABASE_MYSQL_DSN=
EULER_DATABASE_POSTGRES_DSN=
EULER_DATABASE_MYSQL_PUBLIC_HOST=
EULER_DATABASE_MYSQL_PUBLIC_PORT=3306
EULER_DATABASE_POSTGRES_PUBLIC_HOST=
EULER_DATABASE_POSTGRES_PUBLIC_PORT=5432
EULER_DATABASE_PHPMYADMIN_URL=
EULER_DATABASE_ADMINER_URL=

# Euler-owned S3/MinIO infrastructure (endpoint is host:port, without a URL scheme).
# Public endpoint must be reachable by browsers for signed uploads and downloads.
EULER_STORAGE_S3_ENDPOINT=
EULER_STORAGE_S3_ACCESS_KEY=
EULER_STORAGE_S3_SECRET_KEY=
EULER_STORAGE_S3_REGION=us-east-1
EULER_STORAGE_S3_SECURE=true
EULER_STORAGE_S3_PUBLIC_ENDPOINT=
# bucket: S3/AIStor bucket CORS APIs; external: community MinIO or gateway-managed CORS.
# In external mode configure the data plane's MINIO_API_CORS_ALLOW_ORIGIN to the Euler origin.
EULER_STORAGE_S3_CORS_MODE=bucket
# Optional comma-separated browser origins; defaults to EULER_PUBLIC_URL origin.
EULER_STORAGE_CORS_ORIGINS=

# Optional EID notification defaults; project overrides are encrypted in Euler.
EULER_EID_SMTP_ADDRESS=
EULER_EID_SMTP_FROM=
EULER_EID_SMTP_USERNAME=
EULER_EID_SMTP_PASSWORD=
EULER_EID_SMTP_IMPLICIT_TLS=false
EULER_EID_ALLOW_LOCAL_SMTP=false
EULER_EID_WECOM_URL=
EULER_EID_FEISHU_URL=

# Trust notification destinations (never include personal materials in messages).
EULER_NOTIFY_WECOM_URL=
EULER_NOTIFY_FEISHU_URL=
